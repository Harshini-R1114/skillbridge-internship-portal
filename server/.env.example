# SkillBridge Backend Environment Configuration
# Copy this file to .env and configure your production credentials

# 1. MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/skillbridge?retryWrites=true&w=majority

# 2. JWT Secret Key for HMAC-SHA256 Token Encryption
JWT_SECRET=skillbridge_super_secure_production_secret_key_2026

# 3. Server Port (Render defaults to 10000 or dynamically assigns)
PORT=5000

# 4. Environment Mode
NODE_ENV=production

# 5. Production Frontend URL for CORS Whitelisting
FRONTEND_URL=https://skillbridge-internship-portal.vercel.app
